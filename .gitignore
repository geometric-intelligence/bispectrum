# Run outputs (results.json, logs, checkpoints) stay out of git. No trailing slash, so a
# symlink to an external results store is ignored too.
/results
experiments/**/*_results
experiments/**/*_results_*

# camera-ready reruns: stale results moved aside by rebuttal/archive_stale_results.py
*_pre040/
*_prefloor/
*_earlystop/
*_preheadfix/

# Internal decks, review records and rebuttal texts stay out of this public repo
slides/
neurips_review.md
rebuttal/reviewer_*.md
rebuttal/global.md
rebuttal/rebuttal.*
